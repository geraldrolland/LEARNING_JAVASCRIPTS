<!-- 2) Toggle Background Color assessment 2 -->
<button onclick="changeColor()">Change Background</button>

<script>
let isBlue = false;

function changeColor() {
    if (isBlue) {
        document.body.style.backgroundColor = "white";
    } else {
        document.body.style.backgroundColor = "lightblue";
    }

    isBlue = !isBlue;
}
</script>